<!-- prettier-ignore -->
{% extends "layouts/base.njk" %}
{% set title = "Про компанію" %}
{% block content %}

<main class="double-column-page">
  <div class="container">
    <div class="double-column-page__grid">
      <!-- Sidebar navigation - категорії каталогу -->
      <aside class="double-column-page__nav">
        <section class="double-column-page__nav_section">
          <h3 class="active">
            <a href="">Про компанію</a>
          </h3>
        </section>
        <section class="double-column-page__nav_section">
          <h3>
            <a href="">Оплата та Доставка</a>
          </h3>
        </section>
        <section class="double-column-page__nav_section">
          <h3>
            <a href="">Контакти</a>
          </h3>
        </section>
        <section class="double-column-page__nav_section">
          <h3>
            <a href="">Політика конфіденційності</a>
          </h3>
        </section>
        <section class="double-column-page__nav_section">
          <h3>
            <a href="">Договір оферта</a>
          </h3>
        </section>
        <section class="double-column-page__nav_section">
          <h3>
            <a href="">Правила повернення товару</a>
          </h3>
        </section>
        <section class="double-column-page__nav_section">
          <h3>
            <a href="">Співпраця</a>
          </h3>
        </section>
      </aside>
      <div class="services-page__content">
        <!-- Breadcrumbs -->
        <sl-breadcrumb>
          <sl-breadcrumb-item href="#">Озеленення і Фітодизайн</sl-breadcrumb-item>
          <sl-breadcrumb-item href="#">Контакти</sl-breadcrumb-item>
        </sl-breadcrumb>

        <h1>Контакти</h1>
        <section class="services-page__map">
          <div class="services-page__map_list">
            <div class="map-list__item">
              <div class="map-list__item_icon">
                <img src="/img/icons/icon-dish.svg" alt="" />
              </div>
              <div class="map-list__item_info">
                <div class="grid">
                  <div>
                    <span>Телефон у Києві</span>
                    <span>
                      Мобільний
                      <i class="ico"><img src="/img/icons/icon-whatsapp.svg" alt="" /></i>
                      <i class="ico"><img src="/img/icons/icon-telegram.svg" alt="" /></i>
                    </span>
                    <span>e-mail:</span>
                  </div>
                  <div>
                    <a href="tel:+380443442893">(044) 344-28-93</a>
                    <a href="tel:+380506605268">(050) 660-52-68</a>
                    <a href="mailto:info@floren.com.ua">info@floren.com.ua</a>
                  </div>
                </div>
              </div>
            </div>
            <div class="map-list__item">
              <div class="map-list__item_icon">
                <img src="/img/icons/icon-post.svg" alt="" />
              </div>
              <div class="map-list__item_info">
                <p>Магазин кімнатних рослин у Києві</p>
                <p class="contacts-street">
                  <svg class="icon icon-location"></svg>
                  <a href="https://goo.gl/maps/UPpaCBkrMd2TWfXq7" target="_blank">пр. Берестейський, 70</a>
                </p>
                <p>Пн-Сб: 09:00-19:30,</p>
                <p>Нд: 10:00-18:00</p>
              </div>
            </div>
            <div class="map-list__item">
              <div class="map-list__item_icon">
                <img src="/img/icons/icon-track.svg" alt="" />
              </div>
              <div class="map-list__item_info">
                <p>Доставка замовлень: Пн-Нд: 10.00-18.00</p>
                <p>
                  <a href="/delivery/">Детальніше про доставку</a>
                </p>
                <p>Прийом замовлень на сайті – цілодобово.</p>
              </div>
            </div>
          </div>
          <div class="grow">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2540.1043824082894!2d30.428109999999997!3d50.457780899999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40d4cd237e4dd357%3A0x1a7d92ceb23c77ee!2z0KTQu9C-0YDQtdC9!5e0!3m2!1suk!2sua!4v1720701473195!5m2!1suk!2sua"
              width="100%"
              height="100%"
              style="border: 0; max-width: 100%; aspect-ratio: 1"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </section>
      </div>
    </div>
  </div>
</main>

<!-- Модальне вікно перегляду фото -->
{% include "components/photo-viewer-modal.njk" %} {% endblock %}
